# Server
PORT=3100

# WhatsApp
WHATSAPP_SESSION_ID=your-session-id

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/wha_metrics

PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Queue tuning (latencia vs estabilidad)
MESSAGE_QUEUE_DELAY_MS=1000
MESSAGE_QUEUE_MAX_SIZE=500

# Retry tuning
WHATSAPP_RETRY_BASE_DELAY_MS=3000

# Download timeout for media/files (ms)
WHATSAPP_DOWNLOAD_TIMEOUT_MS=20000

# Groups endpoint tuning (ms / concurrency)
WHATSAPP_GROUPS_CACHE_TTL_MS=30000
WHATSAPP_GROUPS_LIST_TIMEOUT_MS=8000
WHATSAPP_GROUP_DETAILS_TIMEOUT_MS=1200
WHATSAPP_GROUP_IMAGE_TIMEOUT_MS=1000
WHATSAPP_GROUPS_MAX_CONCURRENCY=20